# Copy to .env and fill in. Used by both the app and docker compose.

# Namecheap VPS domain settings.
# Point this domain's A record to your VPS public IP before starting Caddy.
DOMAIN="moroccanmun.org"
ACME_EMAIL="admin@moroccanmun.org"

# CI supplies an immutable SHA tag during deployment. This fallback is useful
# for manual recovery and must match the image published by GitHub Actions.
APP_IMAGE="ghcr.io/palladiommahad-byte/myimun:latest"

# Local dev DB (relative to the prisma/ folder). In Docker, compose overrides
# this with an absolute path inside the container.
DATABASE_URL="file:./data/app.db"

# Required in production. Generate one with: openssl rand -base64 48
JWT_SECRET="GENERATE_ON_THE_VPS_WITH_OPENSSL_RAND_BASE64_48"

# One-time token required to create the first admin at /setup-admin.
# Generate separately: openssl rand -base64 48
INITIAL_ADMIN_TOKEN="GENERATE_A_DIFFERENT_VALUE_WITH_OPENSSL_RAND_BASE64_48"

# Session cookie lifetime in days.
SESSION_DAYS="7"
